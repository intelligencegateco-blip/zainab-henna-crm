# Copy to .env.local and adjust. All variables are read in src/config/env.ts.

# Where data comes from:
#   local -> browser storage seeded with demo data (no backend needed)
#   api   -> REST backend at VITE_API_BASE_URL (see README "Backend integration")
VITE_DATA_SOURCE=local

# Base URL of the future REST API (only used when VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:4000/api

# Simulated network delay for the local data source, in milliseconds.
# Keeps loading states honest during development. Use 0 for instant.
VITE_MOCK_LATENCY_MS=250

# Demo sign-in used until real authentication exists.
VITE_DEMO_EMAIL=zainab@zainabhenna.example
VITE_DEMO_PASSWORD=henna2026
# Set to false to hide the demo credentials on the sign-in page (public demos)
VITE_SHOW_DEMO_LOGIN=true
# Set to false to turn the shared demo account off entirely (public builds)
VITE_ENABLE_DEMO_LOGIN=true

# Owner account. Generate the credential with:
#   npm run owner:credential -- you@example.com
# It is a PBKDF2 hash of email + password; neither appears in the built app.
# Put the real value in .env.production.local (git-ignored), never in this file.
VITE_OWNER_CREDENTIAL=
VITE_OWNER_NAME=Owner

# Business defaults (editable later in Settings)
VITE_BUSINESS_NAME=Zainab Henna
VITE_DEFAULT_EXCHANGE_RATE=190
