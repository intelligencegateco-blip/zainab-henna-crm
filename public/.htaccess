# Single-page app routing for Apache/LiteSpeed hosts (e.g. Hostinger):
# serve real files as-is, send every other path to index.html.
Options -Indexes
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
# The PHP API has its own rules in api/.htaccess.
RewriteRule ^api(/|$) - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Long cache for fingerprinted build assets; always revalidate the HTML.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
