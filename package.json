{
  "name": "zainab-henna-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run test:e2e:api",
    "api": "php -S 127.0.0.1:8000 api/index.php",
    "dev:api": "VITE_DATA_SOURCE=api VITE_API_BASE_URL=/api vite",
    "test:e2e:api": "playwright test -c playwright.api.config.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "description": "CRM for Zainab Henna: leads, pipeline, bookings, services and analytics.",
  "engines": {
    "node": ">=20"
  }
}
